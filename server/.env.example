# Postgres connection string (Neon: copy it from the dashboard, keep ?sslmode=require)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/bookstore
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=change-me
# Public URL of this server (used by the auth library)
BETTER_AUTH_URL=http://localhost:3001
# Public URL of the React client (CORS + trusted origin)
CLIENT_URL=http://localhost:5173
PORT=3001
